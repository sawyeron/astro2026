---
import MediaCard from "./MediaCard.astro";
import type { MediaCardItem } from "../../lib/movies";
type Props = {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  countLabel: string;
  items: MediaCardItem[];
};
const { id, title, items } = Astro.props;
---

<section class="media-shelf" id={id} aria-labelledby={`${id}-heading`}>
  <header class="shelf-heading"><h2 id={`${id}-heading`}>{title}</h2></header>
  <ol id={`${id}-rail`} class="media-rail" aria-label={title} tabindex="0">
    {items.map((item) => <MediaCard item={item} fallbackHref={`#${id}`} />)}
  </ol>
  <slot />
</section>
<style>
  .media-shelf {
    position: relative;
    scroll-margin-top: 1rem;
  }
  .media-shelf + .media-shelf {
    margin-top: clamp(3.5rem, 6vw, 6rem);
  }
  .shelf-heading {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-right: 8.5rem;
    margin-bottom: 1rem;
  }
  h2 {
    font: 700 clamp(1.25rem, 2vw, 1.7rem)/1.4 var(--font-sans);
    letter-spacing: -0.05em;
    margin: 0;
  }
  .media-rail {
    display: flex;
    gap: clamp(0.7rem, 1.3vw, 1.2rem);
    list-style: none;
    margin: 0;
    padding: 0.7rem 0.4rem 0.5rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: 0.2rem;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }
  .media-rail::-webkit-scrollbar {
    display: none;
  }
  .media-rail:focus-visible {
    outline: 1px solid var(--cinema-accent);
    outline-offset: 0.3rem;
  }
</style>
