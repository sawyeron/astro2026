---
import type { MovieHistoryEntry } from "../../lib/movies";
type Props = { entries: MovieHistoryEntry[] };
const { entries } = Astro.props;
const formatter = new Intl.DateTimeFormat("zh-CN", {
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
});
---

<section id="watch-log" aria-labelledby="watch-log-heading">
  <header>
    <h2 id="watch-log-heading">近期观看明细</h2><span
      >最近 {entries.length} 次观看</span
    >
  </header>
  <ol>
    {
      entries.map((entry) => (
        <li>
          <>
            <time datetime={entry.watchedAt}>
              {formatter.format(new Date(entry.watchedAt))}
            </time>
            <strong>{entry.media.title}</strong>
            <span>
              {entry.type === "episode"
                ? `S${entry.episode?.season ?? "?"} E${entry.episode?.number ?? "?"}`
                : "电影"}
            </span>
          </>
        </li>
      ))
    }
  </ol>
</section>
<style>
  section {
    margin-top: 4rem;
    scroll-margin-top: 1rem;
    font-family: var(--font-sans);
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  h2 {
    font-size: 1.4rem;
    font-weight: 700;
  }
  header span {
    font-size: 0.7rem;
    color: var(--cinema-muted);
  }
  ol {
    list-style: none;
    padding: 0.5rem 1.25rem;
    margin: 0;
    border-radius: 20px;
    background: #ffffff06;
  }
  li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 5rem;
    gap: 1rem;
    border-top: 1px solid var(--cinema-rule);
    padding: 0.85rem 0;
    font-size: 0.8rem;
  }
  time,
  li > span {
    color: var(--cinema-muted);
    font-family: var(--font-sans);
    font-size: 0.7rem;
  }
  li:first-child {
    border-top: 0;
  }
  strong {
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  li > span {
    text-align: right;
  }
  @media (max-width: 30rem) {
    li {
      grid-template-columns: 3rem minmax(0, 1fr) 4rem;
      gap: 0.5rem;
    }
  }
</style>
