---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  updated?: Date;
  categories?: string[];
  tags?: string[];
  contentKind?:
    "legal" | "technical" | "note" | "culture" | "personal" | "mixed";
  timeSensitive?: boolean;
  legalDisclaimer?: boolean;
}

const {
  title,
  description,
  date,
  updated,
  categories = [],
  tags = [],
  contentKind,
  timeSensitive = false,
  legalDisclaimer = false,
} = Astro.props;
const formatter = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <header class="article-header">
      <a class="home-link" href="/">小法进阶</a>
      {contentKind && <p class="content-kind">{contentKind}</p>}
      <h1>{title}</h1>
      {
        date && (
          <p class="article-meta">
            发布于{" "}
            <time datetime={date.toISOString()}>{formatter.format(date)}</time>
            {updated && <> · 更新于 {formatter.format(updated)}</>}
          </p>
        )
      }
      {
        (categories.length > 0 || tags.length > 0) && (
          <p class="taxonomy">
            {categories.map((category) => (
              <a href={`/categories/${encodeURIComponent(category)}/`}>
                {category === "null" ? "未分类" : category}
              </a>
            ))}
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}/`}>
                #{tag === "null" ? "未分类" : tag}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      timeSensitive && (
        <aside class="notice" aria-label="时效提示">
          本文涉及可能随时间变化的规则、数据或软件环境，请结合现行资料核验。
        </aside>
      )
    }

    <div class="article-body"><slot /></div>

    {
      legalDisclaimer && (
        <aside class="disclaimer" aria-label="法律免责声明">
          本文仅为个人知识记录与一般信息，不构成针对具体事项的法律意见。
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 48rem;
    margin: 0 auto;
  }
  .article-header {
    border-top: 4px solid var(--ink);
    margin-bottom: 3rem;
    padding-top: 1rem;
  }
  .home-link,
  .content-kind {
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .content-kind {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    margin: 2.5rem 0 0;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2.3rem, 7vw, 4.8rem);
    letter-spacing: -0.055em;
    line-height: 1.05;
    margin: 1rem 0;
  }
  .article-meta,
  .taxonomy {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
  }
  .taxonomy a {
    text-decoration: none;
  }
  .notice,
  .disclaimer {
    border-left: 3px solid var(--accent);
    background: #eeebe2;
    margin: 2rem 0;
    padding: 1rem 1.2rem;
  }
  .article-body :global(h2) {
    border-bottom: 1px solid var(--rule);
    font-size: 1.65rem;
    margin-top: 3rem;
    padding-bottom: 0.35rem;
  }
  .article-body :global(h3) {
    margin-top: 2.2rem;
  }
  .article-body :global(img),
  .article-body :global(svg) {
    display: block;
    height: auto;
    max-width: 100%;
    margin: 2rem auto;
  }
  .article-body :global(pre) {
    background: #20282b;
    border-radius: 2px;
    color: #f4f0e6;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.86rem;
    line-height: 1.65;
    overflow-x: auto;
    padding: 1rem 1.15rem;
  }
  .article-body :global(:not(pre) > code) {
    background: #ebe7dc;
    border: 1px solid #d7d1c4;
    border-radius: 2px;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.88em;
    padding: 0.08em 0.3em;
  }
  .article-body :global(table) {
    border-collapse: collapse;
    display: block;
    font-size: 0.92rem;
    margin: 2rem 0;
    max-width: 100%;
    overflow-x: auto;
    white-space: nowrap;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--rule);
    padding: 0.55rem 0.7rem;
    text-align: left;
  }
  .article-body :global(th) {
    background: #ebe7dc;
  }
  .article-body :global(a) {
    overflow-wrap: anywhere;
  }
  .article-body :global(blockquote) {
    border-left: 2px solid var(--rule);
    color: var(--muted);
    margin-left: 0;
    padding-left: 1.2rem;
  }
  .article-body :global(.footnotes) {
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    margin-top: 4rem;
  }
  .disclaimer {
    border-left-color: var(--rule);
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 4rem;
  }
</style>
