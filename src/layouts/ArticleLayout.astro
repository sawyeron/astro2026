---
import BaseLayout from "./BaseLayout.astro";
import { topicLabels, type Topic } from "../lib/topics";

interface ArticleReference {
  title: string;
  href: string;
  date: Date;
}

interface Props {
  title: string;
  description?: string;
  date?: Date;
  updated?: Date;
  categories?: string[];
  tags?: string[];
  topics?: Topic[];
  contentKind?:
    "legal" | "technical" | "note" | "culture" | "personal" | "mixed";
  timeSensitive?: boolean;
  timeSensitivityKind?:
    | "annual-data"
    | "legal-rule"
    | "temporary-policy"
    | "software-version"
    | "historical-material"
    | "general";
  legalDisclaimer?: boolean;
  readingMinutes?: number;
  previousArticle?: ArticleReference;
  nextArticle?: ArticleReference;
}
const {
  title,
  description,
  date,
  updated,
  categories = [],
  tags = [],
  topics = [],
  contentKind,
  timeSensitive = false,
  timeSensitivityKind = "general",
  legalDisclaimer = false,
  readingMinutes,
  previousArticle,
  nextArticle,
} = Astro.props;
const formatter = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const compactFormatter = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const contentKindLabels = {
  legal: "法律",
  technical: "技术",
  note: "札记",
  culture: "文化",
  personal: "个人",
  mixed: "综合",
};
const timeSensitivityMessages = {
  "annual-data":
    "本文记录特定年度的统计数据或适用标准，仅适用于相应期间。处理现时事项时，请查询最新年度数据和适用口径。",
  "legal-rule":
    "本文基于写作时有效的法律、司法解释或政策文件，相关规则可能已经修改、废止或被新规定替代。",
  "temporary-policy":
    "本文记录特定时期的临时政策或应急规则，不宜直接用于判断当前事项，请核验现行规定。",
  "software-version":
    "本文基于写作时的软件、系统或服务版本，界面、命令和操作方式可能已经发生变化。",
  "historical-material":
    "本文保存的是特定年份的历史资料，不代表当前考试范围、招生政策或培养要求。",
  general: "本文涉及可能随时间变化的信息，请结合现行资料核验。",
};
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href="/">小法进阶</a><span aria-hidden="true">/</span><a
          href="/archives/">文章归档</a
        ><span aria-hidden="true">/</span><span>正文</span>
      </nav>

      <div class="header-grid">
        <div class="headline">
          <p class="article-label">
            ARTICLE
            {contentKind && <> / {contentKindLabels[contentKind]}</>}
          </p>
          <h1>{title}</h1>
          {description && <p class="dek">{description}</p>}
        </div>

        <dl class="article-facts" aria-label="文章信息">
          {
            date && (
              <div>
                <dt>发布</dt>
                <dd>
                  <time datetime={date.toISOString()}>
                    {formatter.format(date)}
                  </time>
                </dd>
              </div>
            )
          }
          {
            updated && (
              <div>
                <dt>更新</dt>
                <dd>
                  <time datetime={updated.toISOString()}>
                    {formatter.format(updated)}
                  </time>
                </dd>
              </div>
            )
          }
          {
            readingMinutes && (
              <div>
                <dt>阅读</dt>
                <dd>约 {readingMinutes} 分钟</dd>
              </div>
            )
          }
          {
            topics.length > 0 && (
              <div>
                <dt>专题</dt>
                <dd class="fact-links">
                  {topics.map((topic) => (
                    <a href={`/topics/${topic}/`}>{topicLabels[topic]}</a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      {
        (categories.length > 0 || tags.length > 0) && (
          <div class="taxonomy" aria-label="文章分类和标签">
            <span>INDEX</span>
            <div>
              {categories.map((category) => (
                <a href={`/categories/${encodeURIComponent(category)}/`}>
                  {category === "null" ? "未分类" : category}
                </a>
              ))}
              {tags.map((tag) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>
                  #{tag === "null" ? "未分类" : tag}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </header>

    {
      timeSensitive && (
        <aside
          class={`notice notice-${timeSensitivityKind}`}
          aria-label="时效提示"
        >
          <div>
            <span aria-hidden="true">!</span>
            <strong>时效提示</strong>
          </div>
          <p>{timeSensitivityMessages[timeSensitivityKind]}</p>
        </aside>
      )
    }

    <div class="reading-column">
      <div class="article-body"><slot /></div>

      {
        legalDisclaimer && (
          <aside class="disclaimer" aria-label="法律免责声明">
            <strong>法律信息说明</strong>
            <p>
              本文仅为个人知识记录与一般信息，不构成针对具体事项的法律意见。
            </p>
          </aside>
        )
      }
    </div>

    <footer class="article-footer">
      <a class="back-to-top" href="#main-content">↑ 返回页首</a>

      <nav class="article-navigation" aria-label="文章导航">
        <div class:list={["article-neighbor", { empty: !previousArticle }]}>
          {
            previousArticle ? (
              <>
                <p>
                  <span aria-hidden="true">←</span> 上一篇 · 较早
                </p>
                <a href={previousArticle.href}>{previousArticle.title}</a>
                <time datetime={previousArticle.date.toISOString()}>
                  {compactFormatter.format(previousArticle.date)}
                </time>
              </>
            ) : (
              <p>已经是最早一篇</p>
            )
          }
        </div>
        <div class:list={["article-neighbor", { empty: !nextArticle }]}>
          {
            nextArticle ? (
              <>
                <p>
                  下一篇 · 较新 <span aria-hidden="true">→</span>
                </p>
                <a href={nextArticle.href}>{nextArticle.title}</a>
                <time datetime={nextArticle.date.toISOString()}>
                  {compactFormatter.format(nextArticle.date)}
                </time>
              </>
            ) : (
              <p>已经是最新一篇</p>
            )
          }
        </div>
      </nav>

      <div class="return-routes">
        <span>CONTINUE</span>
        <a href="/topics/">浏览专题</a>
        <a href="/archives/">查看全部文章</a>
        <a href="/search/">全文搜索</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    margin: 0 auto;
    max-width: 76rem;
  }
  .article-header {
    border-top: var(--border-hairline);
    margin-bottom: clamp(3rem, 8vw, 6rem);
    padding-top: 0.75rem;
  }
  .breadcrumbs,
  .article-label,
  .article-facts,
  .taxonomy,
  .notice,
  .article-navigation,
  .back-to-top,
  .return-routes {
    font-family: var(--font-sans);
  }
  .breadcrumbs {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--font-size-sm);
    gap: 0.45rem;
  }
  .header-grid {
    align-items: end;
    display: grid;
    gap: clamp(2rem, 7vw, 7rem);
    grid-template-columns: minmax(0, 1.8fr) minmax(13rem, 0.45fr);
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .article-label {
    color: var(--accent);
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-label);
    margin: 0 0 0.9rem;
  }
  h1 {
    font-size: clamp(2.85rem, 6.3vw, 5.7rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.12;
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }
  .dek {
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--font-size-lede);
    line-height: 1.65;
    margin: 1.5rem 0 0;
    max-width: 44rem;
  }
  .article-facts {
    border-top: var(--border-hairline);
    margin: 0;
  }
  .article-facts > div {
    border-bottom: var(--border-hairline);
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 3.2rem 1fr;
    padding: 0.65rem 0;
  }
  .article-facts dt,
  .article-facts dd {
    font-size: var(--font-size-meta);
    margin: 0;
  }
  .article-facts dt {
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .article-facts dd {
    color: var(--muted);
    line-height: 1.5;
  }
  .fact-links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .taxonomy {
    align-items: start;
    border-bottom: var(--border-hairline);
    border-top: var(--border-hairline);
    display: grid;
    gap: 1rem;
    grid-template-columns: 4rem 1fr;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: 0.7rem 0;
  }
  .taxonomy > span {
    color: var(--accent);
    font-size: var(--font-size-meta);
    letter-spacing: 0.1em;
  }
  .taxonomy > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .taxonomy a {
    color: var(--muted);
    font-size: var(--font-size-meta);
    text-decoration: none;
  }
  .notice {
    border-bottom: var(--border-hairline);
    border-top: var(--border-hairline);
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 8rem 1fr;
    margin: 0 auto clamp(3rem, 7vw, 5rem);
    max-width: var(--measure-reading);
    padding: 1rem 0;
  }
  .notice > div {
    align-items: center;
    display: flex;
    gap: 0.6rem;
  }
  .notice > div > span {
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--accent);
    display: flex;
    font-size: 0.65rem;
    height: 1.4rem;
    justify-content: center;
    width: 1.4rem;
  }
  .notice strong {
    font-size: var(--font-size-meta);
    letter-spacing: 0.1em;
  }
  .notice p {
    color: var(--color-ink-soft);
    font-family: var(--font-serif);
    font-size: var(--font-size-sm);
    line-height: 1.75;
    margin: 0;
  }
  .notice-software-version,
  .notice-historical-material {
    border-left: 0;
  }
  .reading-column {
    margin: 0 auto;
    max-width: var(--measure-reading);
  }
  .article-body {
    font-size: var(--font-size-body);
    overflow-wrap: break-word;
  }
  .article-body > :global(:first-child) {
    margin-top: 0;
  }
  .article-body :global(p),
  .article-body :global(li) {
    hanging-punctuation: first allow-end last;
  }
  .article-body :global(p) {
    margin: 1.2em 0;
  }
  .article-body :global(h2) {
    border-top: var(--border-hairline);
    font-size: clamp(1.7rem, 3.2vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin: 4rem 0 1.2rem;
    padding-top: 0.75rem;
    scroll-margin-top: 1.5rem;
  }
  .article-body :global(h3) {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.45;
    margin: 2.8rem 0 0.8rem;
    scroll-margin-top: 1.5rem;
  }
  .article-body :global(h4) {
    color: var(--color-ink-soft);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.55;
    margin: 2rem 0 0.6rem;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.4rem;
  }
  .article-body :global(li) {
    margin: 0.45rem 0;
    padding-left: 0.25rem;
  }
  .article-body :global(li::marker) {
    color: var(--accent);
  }
  .article-body :global(hr) {
    border: 0;
    border-top: var(--border-hairline);
    margin: 3.5rem auto;
    width: 40%;
  }
  .article-body :global(img),
  .article-body :global(svg) {
    display: block;
    height: auto;
    margin: 2.5rem auto;
    max-width: 100%;
  }
  .article-body :global(figure) {
    margin: 2.5rem 0;
  }
  .article-body :global(figure img) {
    margin-bottom: 0.6rem;
  }
  .article-body :global(figcaption) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    line-height: 1.6;
    text-align: center;
  }
  .article-body :global(pre) {
    background: var(--color-code);
    border-left: 3px solid var(--accent);
    border-radius: 0;
    color: var(--color-code-ink);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.7;
    margin: 2rem 0;
    overflow-x: auto;
    padding: 1.1rem 1.2rem;
  }
  .article-body :global(:not(pre) > code) {
    background: var(--color-paper-deep);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.08em 0.3em;
  }
  .article-body :global(table) {
    border-collapse: collapse;
    font-size: 0.94rem;
    margin: 2.5rem 0;
    width: 100%;
  }
  .article-body :global(.table-scroll) {
    max-width: 100%;
    overflow-x: auto;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--rule);
    padding: 0.6rem 0.75rem;
    text-align: left;
  }
  .article-body :global(th) {
    background: var(--color-paper-deep);
  }
  .article-body :global(a) {
    overflow-wrap: anywhere;
  }
  .article-body :global(blockquote) {
    border-left: 2px solid var(--accent);
    color: var(--color-ink-soft);
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    line-height: 1.75;
    margin: 2.5rem 0;
    padding: 0.35rem 0 0.35rem 1.25rem;
  }
  .article-body :global(blockquote > :first-child) {
    margin-top: 0;
  }
  .article-body :global(blockquote > :last-child) {
    margin-bottom: 0;
  }
  .article-body :global(details) {
    border-bottom: var(--border-hairline);
    border-top: var(--border-hairline);
    margin: 2rem 0;
    padding: 0.8rem 0;
  }
  .article-body :global(summary) {
    cursor: pointer;
    font-weight: 700;
  }
  .article-body :global(.footnotes),
  .article-body :global(.footnotes-area) {
    border-top: 2px solid var(--ink);
    font-size: var(--font-size-sm);
    margin-top: 5rem;
    padding-top: 0.5rem;
  }
  .article-body :global(.footnote-line) {
    border-bottom: 1px solid var(--rule);
    padding: 0.8rem 0;
    scroll-margin-top: 1.5rem;
  }
  .article-body :global(.md-fn-count) {
    color: var(--accent);
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    min-width: 2rem;
  }
  .article-body :global(sup[id]) {
    scroll-margin-top: 1.5rem;
  }
  .article-body :global(sup a),
  .article-body :global(.footnote-backref) {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    text-decoration: none;
  }
  .article-body :global(:target) {
    animation: footnote-highlight 1.6s ease-out;
  }
  @keyframes footnote-highlight {
    from {
      background: var(--color-accent-wash);
    }
    to {
      background: transparent;
    }
  }
  .disclaimer {
    border-bottom: var(--border-hairline);
    border-top: var(--border-hairline);
    color: var(--muted);
    display: grid;
    gap: 1rem;
    grid-template-columns: 8rem 1fr;
    margin-top: 4rem;
    padding: 1rem 0;
  }
  .disclaimer strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }
  .disclaimer p {
    font-size: 0.86rem;
    margin: 0;
  }
  .article-footer {
    margin-top: clamp(5rem, 12vw, 9rem);
  }
  .back-to-top {
    color: var(--muted);
    display: block;
    font-size: 0.66rem;
    margin: 0 0 0.7rem auto;
    text-align: right;
    width: fit-content;
  }
  .article-navigation {
    border-bottom: var(--border-hairline);
    border-top: 1px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .article-neighbor {
    display: flex;
    flex-direction: column;
    min-height: 10rem;
    padding: 1rem 1.5rem 1.2rem 0;
  }
  .article-neighbor + .article-neighbor {
    border-left: var(--border-hairline);
    padding-left: 1.5rem;
    padding-right: 0;
    text-align: right;
  }
  .article-neighbor p {
    color: var(--accent);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    margin: 0 0 1.4rem;
  }
  .article-neighbor > a {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2.3vw, 1.4rem);
    font-weight: 700;
    line-height: 1.35;
  }
  .article-neighbor time {
    color: var(--muted);
    font-size: 0.62rem;
    margin-top: auto;
    padding-top: 1.2rem;
  }
  .article-neighbor.empty {
    color: var(--muted);
    justify-content: center;
  }
  .article-neighbor.empty p {
    color: var(--muted);
    margin: 0;
  }
  .return-routes {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    padding: 0.8rem 0;
  }
  .return-routes span {
    color: var(--accent);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    margin-right: auto;
  }
  .return-routes a {
    font-size: 0.68rem;
  }
  @media (max-width: 48rem) {
    .header-grid {
      align-items: start;
      grid-template-columns: 1fr;
    }
    .article-facts {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    .article-facts > div:nth-child(odd) {
      border-right: var(--border-hairline);
      padding-right: 1rem;
    }
    .article-facts > div:nth-child(even) {
      padding-left: 1rem;
    }
  }
  @media (max-width: 38rem) {
    .notice,
    .disclaimer {
      grid-template-columns: 1fr;
    }
    .article-navigation {
      grid-template-columns: 1fr;
    }
    .article-neighbor {
      min-height: 8rem;
      padding: 1rem 0;
    }
    .article-neighbor + .article-neighbor {
      border-left: 0;
      border-top: var(--border-hairline);
      padding: 1rem 0;
      text-align: left;
    }
    .return-routes {
      align-items: flex-start;
      flex-direction: column;
    }
    .return-routes span {
      margin-bottom: 0.3rem;
    }
  }
  @media (max-width: 30rem) {
    .article-facts {
      grid-template-columns: 1fr;
    }
    .article-facts > div:nth-child(odd),
    .article-facts > div:nth-child(even) {
      border-right: 0;
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
