---
import { site } from "../config/site";

const { title = site.name, description = "法律、技术与个人知识档案。" } =
  Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f5ef" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={`${site.name} Atom`}
      href="/atom.xml"
    />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">跳至主要内容</a>
      <main id="main-content" data-pagefind-body><slot /></main>
      <footer class="site-footer">
        <div>
          <a href="/">小法进阶</a>
          <span aria-hidden="true">/</span>
          <a href="/topics/">专题</a>
          <span aria-hidden="true">/</span>
          <a href="/archives/">归档</a>
          <span aria-hidden="true">/</span>
          <a href="/search/">搜索</a>
          <span aria-hidden="true">/</span>
          <a href="/about/">关于</a>
          <span aria-hidden="true">/</span>
          <a href="/rss.xml">RSS</a>
        </div>
        <p>
          本站无评论系统，不使用 Google Analytics。计划使用 Cloudflare Web
          Analytics 统计汇总访问数据，不建立访客画像。
        </p>
        <p>
          原创内容除特别说明外采用 CC BY 4.0；历史文章请结合其发布日期阅读。
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f7f5ef;
    --ink: #1b2529;
    --muted: #607075;
    --rule: #c8c6bc;
    --accent: #a23d2b;
    font-family: "Noto Serif CJK SC", "Songti SC", "STSong", serif;
    background: var(--paper);
    color: var(--ink);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    line-height: 1.7;
  }

  .site-shell {
    width: min(100% - 2rem, 70rem);
    margin: 0 auto;
    padding: clamp(2rem, 8vw, 7rem) 0 2rem;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  a:hover {
    color: var(--accent);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .skip-link {
    background: var(--ink);
    color: var(--paper);
    left: 1rem;
    padding: 0.55rem 0.8rem;
    position: fixed;
    top: 0;
    transform: translateY(-130%);
    z-index: 100;
  }
  .skip-link:focus {
    color: var(--paper);
    transform: translateY(0);
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.78rem;
    margin-top: clamp(5rem, 12vw, 10rem);
    padding-top: 1.2rem;
  }
  .site-footer > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  }
  .site-footer p {
    margin: 0.6rem 0;
    max-width: 52rem;
  }

  @media print {
    :root {
      --paper: #fff;
      --ink: #000;
      --muted: #333;
      --rule: #aaa;
    }
    .skip-link,
    .site-footer,
    nav {
      display: none !important;
    }
    .site-shell {
      padding: 0;
      width: 100%;
    }
    body {
      font-size: 11pt;
      line-height: 1.55;
    }
    a {
      text-decoration: none;
    }
    @page {
      margin: 18mm 16mm;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
