---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { topicDescriptions, topicLabels, type Topic } from "../../lib/topics";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const topicOrder = Object.keys(topicLabels) as Topic[];
const topicEntries = topicOrder
  .map((topic) => {
    const entries = articles.filter((article) =>
      article.data.topics.includes(topic),
    );
    return {
      topic,
      entries,
      latest: entries[0],
      firstYear: entries.at(-1)?.data.date.getFullYear(),
      lastYear: entries[0]?.data.date.getFullYear(),
    };
  })
  .filter(({ entries }) => entries.length > 0);
const assignedArticles = articles.filter(
  (article) => article.data.topics.length,
);
const years = articles.map((article) => article.data.date.getFullYear());
---

<BaseLayout title="专题" description="经过人工复核的七组主题阅读路径。">
  <header class="topics-header">
    <a class="back" href="/">← 小法进阶</a>
    <div class="header-grid">
      <div>
        <p class="eyebrow">CURATED KNOWLEDGE MAP · 01—07</p>
        <h1>专题</h1>
      </div>
      <div class="intro">
        <p>
          不是关键词的堆叠，而是七条经过人工复核的阅读路径。法律问题、工作方法、数字生活与私人观察在这里重新建立联系。
        </p>
        <dl aria-label="专题概况">
          <div><dt>{topicEntries.length}</dt><dd>条阅读路径</dd></div>
          <div><dt>{assignedArticles.length}</dt><dd>篇已编入文章</dd></div>
          <div>
            <dt>{Math.min(...years)}—{Math.max(...years)}</dt><dd>
              内容时间跨度
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </header>

  <nav class="topic-map" aria-label="专题快速跳转">
    {
      topicEntries.map(({ topic }, index) => (
        <a href={`#topic-${topic}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          {topicLabels[topic]}
        </a>
      ))
    }
  </nav>

  <div class="topic-ledger">
    {
      topicEntries.map(
        ({ topic, entries, latest, firstYear, lastYear }, index) => (
          <article id={`topic-${topic}`}>
            <div class="ordinal" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="topic-copy">
              <p class="range">
                {firstYear === lastYear
                  ? firstYear
                  : `${firstYear}—${lastYear}`}
                <span> / {entries.length} 篇</span>
              </p>
              <h2>
                <a href={`/topics/${topic}/`}>{topicLabels[topic]}</a>
              </h2>
              <p class="description">{topicDescriptions[topic]}</p>
              {latest && (
                <p class="latest">
                  <span>最近收录</span>
                  <a href={latest.data.legacyPath}>{latest.data.title}</a>
                </p>
              )}
            </div>
            <a
              class="enter"
              href={`/topics/${topic}/`}
              aria-label={`进入${topicLabels[topic]}专题`}
            >
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        ),
      )
    }
  </div>

  <aside class="archive-route">
    <p class="eyebrow">ALTERNATE ROUTE</p>
    <div>
      <strong>不知道从哪里开始？</strong>
      <p>按年份浏览全部文章，保留写作发生时的原始次序。</p>
    </div>
    <a href="/archives/">前往文章归档 →</a>
  </aside>
</BaseLayout>

<style>
  .topics-header,
  .topic-map,
  .topic-ledger,
  .archive-route {
    max-width: 66rem;
  }
  .topics-header {
    border-top: var(--border-heading);
    padding-top: var(--space-3);
  }
  .back,
  .eyebrow,
  .range,
  .latest span,
  .topic-map,
  .ordinal {
    font-family: var(--font-mono);
  }
  .back {
    color: var(--muted);
    font-size: var(--font-size-sm);
  }
  .header-grid {
    align-items: end;
    display: grid;
    gap: clamp(2rem, 8vw, 7rem);
    grid-template-columns: minmax(18rem, 1fr) minmax(18rem, 0.8fr);
    margin-top: clamp(3.5rem, 9vw, 7rem);
  }
  .eyebrow {
    color: var(--accent);
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-label);
    margin: 0 0 0.8rem;
  }
  h1 {
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.1em;
    line-height: 0.72;
    margin: 0;
  }
  .intro > p {
    color: var(--color-ink-soft);
    font-size: var(--font-size-lede);
    line-height: 1.65;
    margin: 0 0 2rem;
  }
  dl {
    border-top: var(--border-hairline);
    display: grid;
    grid-template-columns: 0.7fr 1fr 1.4fr;
    margin: 0;
  }
  dl div {
    border-right: var(--border-hairline);
    padding: 0.8rem 0.8rem 0 0;
  }
  dl div + div {
    padding-left: 0.8rem;
  }
  dl div:last-child {
    border-right: 0;
  }
  dt {
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1;
  }
  dd {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    margin: 0.55rem 0 0;
  }
  .topic-map {
    border-bottom: var(--border-hairline);
    border-top: var(--border-hairline);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(4rem, 10vw, 8rem);
  }
  .topic-map a {
    align-items: baseline;
    border-right: var(--border-hairline);
    display: flex;
    font-size: 0.72rem;
    gap: 0.55rem;
    line-height: 1.35;
    padding: 0.75rem;
    text-decoration: none;
  }
  .topic-map a:nth-child(4n) {
    border-right: 0;
  }
  .topic-map span {
    color: var(--accent);
    font-size: 0.62rem;
  }
  .topic-ledger article {
    border-bottom: var(--border-hairline);
    display: grid;
    gap: clamp(1rem, 4vw, 3rem);
    grid-template-columns: clamp(3rem, 8vw, 6rem) minmax(0, 1fr) 3rem;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    scroll-margin-top: 1rem;
  }
  .ordinal {
    color: var(--color-rule-strong);
    font-size: clamp(1.5rem, 4vw, 3rem);
    line-height: 1;
  }
  .range {
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.7rem;
  }
  .range span {
    color: var(--muted);
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    letter-spacing: -0.045em;
    line-height: 1.12;
    margin: 0;
  }
  h2 a {
    text-decoration: none;
  }
  .description {
    color: var(--muted);
    margin: 0.75rem 0 0;
    max-width: 40rem;
  }
  .latest {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    margin: 1.2rem 0 0;
  }
  .latest span {
    color: var(--muted);
    font-size: 0.65rem;
  }
  .latest a {
    font-size: 0.88rem;
  }
  .enter {
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
    display: flex;
    height: 2.75rem;
    justify-content: center;
    text-decoration: none;
    width: 2.75rem;
  }
  .enter:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .archive-route {
    align-items: end;
    background: var(--color-paper-deep);
    border-left: 4px solid var(--accent);
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: 8rem 1fr auto;
    margin-top: var(--space-7);
    padding: var(--space-4);
  }
  .archive-route .eyebrow,
  .archive-route p {
    margin: 0;
  }
  .archive-route strong {
    font-size: 1.2rem;
  }
  .archive-route div p {
    color: var(--muted);
    font-size: 0.88rem;
  }
  @media (max-width: 48rem) {
    .header-grid {
      grid-template-columns: 1fr;
    }
    .topic-map {
      grid-template-columns: repeat(2, 1fr);
    }
    .topic-map a:nth-child(2n) {
      border-right: 0;
    }
    .archive-route {
      align-items: start;
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 32rem) {
    .topic-map {
      grid-template-columns: 1fr;
    }
    .topic-map a {
      border-right: 0;
    }
    .topic-ledger article {
      gap: 0.8rem;
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .enter {
      display: none;
    }
    dl {
      grid-template-columns: 1fr;
    }
    dl div,
    dl div + div {
      border-bottom: var(--border-hairline);
      border-right: 0;
      display: flex;
      justify-content: space-between;
      padding: 0.75rem 0;
    }
    dd {
      margin: 0;
    }
  }
</style>
