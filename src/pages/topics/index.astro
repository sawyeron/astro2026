---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { topicDescriptions, topicLabels, type Topic } from "../../lib/topics";

const articles = await getCollection("blog", ({ data }) => !data.draft);
const counts = new Map<Topic, number>();
for (const article of articles)
  for (const topic of article.data.topics)
    counts.set(topic, (counts.get(topic) ?? 0) + 1);
const topics = (Object.keys(topicLabels) as Topic[]).filter((topic) =>
  counts.has(topic),
);
---

<BaseLayout title="专题" description="经过人工复核的精选内容专题。">
  <header>
    <a class="back" href="/">← 小法进阶</a>
    <p class="eyebrow">CURATED KNOWLEDGE MAP</p>
    <h1>专题</h1>
    <p class="lede">
      专题不同于旧站分类和标签，只收录已经完成人工内容治理复核的文章。
    </p>
  </header>
  <main>
    {
      topics.length ? (
        <ol>
          {topics.map((topic, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <a href={`/topics/${topic}/`}>{topicLabels[topic]}</a>
                <p>{topicDescriptions[topic]}</p>
              </div>
              <strong>{counts.get(topic)} 篇</strong>
            </li>
          ))}
        </ol>
      ) : (
        <aside>
          <strong>专题正在整理</strong>
          <p>84 篇历史文章的候选专题已经生成，待人工复核后逐步在这里公开。</p>
          <a href="/archives/">先浏览完整归档 →</a>
        </aside>
      )
    }
  </main>
</BaseLayout>

<style>
  header,
  main {
    max-width: 58rem;
  }
  header {
    border-top: 4px solid var(--ink);
    padding-top: 1rem;
  }
  .back,
  .eyebrow,
  li > span,
  li > strong {
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  }
  .back,
  .lede {
    color: var(--muted);
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    margin: 3rem 0 0.8rem;
  }
  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    letter-spacing: -0.08em;
    line-height: 0.9;
    margin: 0;
  }
  .lede {
    font-size: 1.08rem;
    margin: 1.5rem 0 4rem;
    max-width: 40rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    align-items: start;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 3rem 1fr auto;
    padding: 1.3rem 0 1.6rem;
  }
  li > span,
  li > strong {
    color: var(--muted);
    font-size: 0.75rem;
  }
  li a {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
  }
  li p {
    color: var(--muted);
    margin: 0.35rem 0 0;
  }
  aside {
    background: #ebe7dc;
    border-left: 4px solid var(--accent);
    padding: 1.5rem;
  }
  aside p {
    color: var(--muted);
  }
  @media (max-width: 38rem) {
    li {
      grid-template-columns: 2rem 1fr;
    }
    li > strong {
      grid-column: 2;
    }
  }
</style>
