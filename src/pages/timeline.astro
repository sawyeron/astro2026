---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const years = new Map<number, typeof articles>();
for (const article of articles) {
  const year = article.data.date.getFullYear();
  if (!years.has(year)) years.set(year, []);
  years.get(year)?.push(article);
}
const formatter = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "Asia/Shanghai",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title="时间线" description="小法进阶全部公开文章的年度时间线。">
  <header>
    <a class="back" href="/">← 小法进阶</a>
    <p class="eyebrow">CHRONOLOGICAL RECORD</p>
    <h1>时间线</h1>
    <p class="lede">
      从 {Math.min(...years.keys())} 到 {Math.max(...years.keys())}，共保存 {
        articles.length
      } 篇公开文章。
    </p>
  </header>
  <div class="timeline">
    {
      [...years].map(([year, yearArticles]) => (
        <section aria-labelledby={`year-${year}`}>
          <div class="year-heading">
            <h2 id={`year-${year}`}>{year}</h2>
            <span>{yearArticles.length} 篇</span>
          </div>
          <ol>
            {yearArticles.map((article) => (
              <li>
                <time datetime={article.data.date.toISOString()}>
                  {formatter.format(article.data.date)}
                </time>
                <a href={article.data.legacyPath}>{article.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  header,
  .timeline {
    max-width: 58rem;
  }
  header {
    border-top: 4px solid var(--ink);
    padding-top: 1rem;
  }
  .back,
  .eyebrow,
  time,
  .year-heading span {
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
  }
  .back,
  .lede {
    color: var(--muted);
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    margin: 3rem 0 0.8rem;
  }
  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    letter-spacing: -0.08em;
    line-height: 0.9;
    margin: 0;
  }
  .lede {
    margin: 1.5rem 0 5rem;
  }
  section {
    display: grid;
    gap: 2rem;
    grid-template-columns: 8rem 1fr;
    margin-bottom: 4rem;
  }
  .year-heading {
    position: sticky;
    top: 1rem;
    align-self: start;
  }
  h2 {
    font-size: 2.5rem;
    letter-spacing: -0.05em;
    line-height: 1;
    margin: 0;
  }
  .year-heading span {
    color: var(--muted);
    font-size: 0.72rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 1rem;
    grid-template-columns: 4rem 1fr;
    padding: 0.75rem 0 0.9rem;
  }
  time {
    color: var(--muted);
    font-size: 0.78rem;
  }
  @media (max-width: 38rem) {
    section {
      gap: 1rem;
      grid-template-columns: 1fr;
    }
    .year-heading {
      background: var(--paper);
      display: flex;
      gap: 1rem;
      padding: 0.5rem 0;
      position: sticky;
    }
  }
</style>
