---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout description="法律、技术与个人知识档案。">
  <header>
    <p class="eyebrow">IMOUYANG.COM · PERSONAL ARCHIVE</p>
    <h1>小法进阶</h1>
    <p class="lede">
      法律、技术与个人知识档案。历史文章已按原公开地址迁入 Astro 静态站点。
    </p>
    <nav aria-label="主要导航">
      <a href="/archives/">归档</a><a href="/categories/">分类</a><a
        href="/tags/">标签</a
      ><a href="/timeline/">时间线</a><a href="/about/">关于</a><a href="/PGP/"
        >PGP</a
      >
    </nav>
  </header>

  <section aria-labelledby="articles-heading">
    <h2 id="articles-heading">最近文章</h2>
    <ol>
      {
        articles.slice(0, 12).map((article) => (
          <li>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.getFullYear()}
            </time>
            <a href={article.data.legacyPath}>{article.data.title}</a>
          </li>
        ))
      }
    </ol>
    <p><a href="/timeline/">查看全部 {articles.length} 篇文章 →</a></p>
  </section>
</BaseLayout>

<style>
  header {
    border-top: 4px solid var(--ink);
    padding-top: 1rem;
  }
  .eyebrow {
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
  }
  h1 {
    font-size: clamp(3.6rem, 12vw, 8rem);
    letter-spacing: -0.09em;
    line-height: 0.88;
    margin: 0.5rem 0 2rem;
  }
  .lede {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 38rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 2rem 0 6rem;
  }
  section {
    max-width: 48rem;
  }
  h2 {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
  }
  ol {
    list-style: none;
    padding: 0;
  }
  li {
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 1rem;
    grid-template-columns: 4rem 1fr;
    padding: 0.8rem 0;
  }
  time {
    color: var(--muted);
    font-family: ui-monospace, monospace;
  }
</style>
