---
import MediaRail from "../components/movies/MediaRail.astro";
import CollectionGrid from "../components/movies/CollectionGrid.astro";
import WatchLog from "../components/movies/WatchLog.astro";
import ImageFallback from "../components/movies/ImageFallback.astro";
import ScreeningHeader from "../components/movies/ScreeningHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectionMediaCards, type MovieSnapshot } from "../lib/movies";
import traktData from "../data/trakt-public-history.json";

const data = traktData as unknown as MovieSnapshot;
const movies = collectionMediaCards(data.movies);
const shows = collectionMediaCards(data.shows);
---

<BaseLayout title="观影" description="私人观影记录。" theme="cinema">
  <ScreeningHeader
    historyCount={data.counts.history}
    movieCount={data.movies.length}
    showCount={data.shows.length}
    history={data.history}
  />

  <div class="screening-library">
    <MediaRail
      id="movies"
      index="02"
      eyebrow="FEATURE FILMS"
      title="电影"
      countLabel={`${movies.length} 部`}
      items={movies.slice(0, 12)}
    >
      <CollectionGrid items={movies} title="电影" sectionId="movies" />
    </MediaRail>
    <MediaRail
      id="shows"
      index="03"
      eyebrow="SERIES"
      title="剧集"
      countLabel={`${shows.length} 部`}
      items={shows.slice(0, 12)}
    >
      <CollectionGrid items={shows} title="剧集" sectionId="shows" />
    </MediaRail>
    <WatchLog entries={data.history.slice(0, 8)} />
  </div>
  <ImageFallback />
</BaseLayout>

<style>
  .screening-library {
    padding: clamp(2.2rem, 4vw, 4rem) 0 clamp(5rem, 9vw, 9rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .screening-library :global(.media-shelf) {
      animation: reveal 0.45s both ease-out;
    }
    .screening-library :global(.media-shelf:nth-child(2)) {
      animation-delay: 0.07s;
    }
    .screening-library :global(.media-shelf:nth-child(3)) {
      animation-delay: 0.14s;
    }
    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(0.55rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
