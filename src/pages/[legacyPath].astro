---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = (
    await getCollection("blog", ({ data }) => !data.draft)
  ).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return articles.map((article, index) => {
    const previous = articles[index - 1];
    const next = articles[index + 1];
    return {
      params: {
        legacyPath: article.data.legacyPath
          ?.replace(/^\//, "")
          .replace(/\/$/, ""),
      },
      props: {
        article,
        previousArticle: previous
          ? { title: previous.data.title, href: previous.data.legacyPath! }
          : undefined,
        nextArticle: next
          ? { title: next.data.title, href: next.data.legacyPath! }
          : undefined,
      },
    };
  });
}

const { article, previousArticle, nextArticle } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  date={article.data.date}
  updated={article.data.updated}
  categories={article.data.categories}
  tags={article.data.tags}
  contentKind={article.data.contentKind}
  timeSensitive={article.data.timeSensitive}
  timeSensitivityKind={article.data.timeSensitivityKind}
  legalDisclaimer={article.data.legalDisclaimer}
  previousArticle={previousArticle}
  nextArticle={nextArticle}
>
  <Content />
</ArticleLayout>
