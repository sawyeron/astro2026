---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = (
    await getCollection("blog", ({ data }) => !data.draft)
  ).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return articles.map((article, index) => {
    const previous = articles[index - 1];
    const next = articles[index + 1];
    return {
      params: {
        legacyPath: article.data.legacyPath
          ?.replace(/^\//, "")
          .replace(/\/$/, ""),
      },
      props: {
        article,
        previousArticle: previous
          ? {
              title: previous.data.title,
              href: previous.data.legacyPath!,
              date: previous.data.date,
            }
          : undefined,
        nextArticle: next
          ? {
              title: next.data.title,
              href: next.data.legacyPath!,
              date: next.data.date,
            }
          : undefined,
      },
    };
  });
}

const { article, previousArticle, nextArticle } = Astro.props;
const { Content } = await render(article);
const readableText = article.body
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/<[^>]+>|[#>*_`(){}|-]/g, " ")
  .replaceAll("[", " ")
  .replaceAll("]", " ");
const cjkCharacters = (readableText.match(/[\u3400-\u9fff]/g) ?? []).length;
const latinWords = (readableText.match(/[A-Za-z0-9]+/g) ?? []).length;
const readingMinutes = Math.max(
  1,
  Math.ceil((cjkCharacters + latinWords * 2) / 450),
);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  date={article.data.date}
  updated={article.data.updated}
  categories={article.data.categories}
  tags={article.data.tags}
  topics={article.data.topics}
  contentKind={article.data.contentKind}
  timeSensitive={article.data.timeSensitive}
  timeSensitivityKind={article.data.timeSensitivityKind}
  legalDisclaimer={article.data.legalDisclaimer}
  readingMinutes={readingMinutes}
  previousArticle={previousArticle}
  nextArticle={nextArticle}
>
  <Content />
</ArticleLayout>
