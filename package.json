{
  "name": "imouyang-archive",
  "version": "0.1.0",
  "description": "Astro static archive for imouyang.com",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prebuild": "node scripts/check-node-version.mjs",
    "dev": "node scripts/check-node-version.mjs && astro dev",
    "start": "node scripts/check-node-version.mjs && astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "build:site": "astro build && pagefind --site dist",
    "check": "node scripts/check-node-version.mjs && astro check",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "verify": "npm run format && npm run lint && npm run test:writing && npm run check && npm run check:assets && npm run check:migration && npm run check:governance && npm run check:content-quality && npm run check:urls && npm run check:snapshots:manifest && npm run build:site && npm run check:drafts && npm run check:links && npm run check:html && npm run check:interactions && npm run check:performance && npm run check:analytics && npm run check:brand && npm run check:urls -- --check-dist && npm run check:syndication && npm run check:search && npm run check:snapshots && npm run check:navigation && npm run check:editorial",
    "check:links": "node scripts/check-dist-links.mjs",
    "check:assets": "node scripts/check-asset-recovery.mjs",
    "migrate:content": "node scripts/migrate-legacy-content.mjs",
    "migrate:content:dry": "node scripts/migrate-legacy-content.mjs --dry-run",
    "check:migration": "node scripts/check-content-migration.mjs",
    "generate:urls": "node scripts/generate-auxiliary-url-manifest.mjs",
    "check:urls": "node scripts/check-auxiliary-urls.mjs",
    "check:syndication": "node scripts/check-syndication.mjs",
    "generate:governance": "node scripts/generate-content-governance-candidates.mjs",
    "check:search": "node scripts/check-search.mjs",
    "generate:snapshots": "node scripts/generate-render-snapshot-manifest.mjs",
    "check:snapshots:manifest": "node scripts/generate-render-snapshot-manifest.mjs --check",
    "check:snapshots": "node scripts/check-render-snapshots.mjs",
    "check:html": "node scripts/check-html-quality.mjs",
    "check:navigation": "node scripts/check-article-navigation.mjs",
    "governance:dry": "node scripts/apply-content-governance.mjs",
    "governance:apply": "node scripts/apply-content-governance.mjs --apply",
    "check:governance": "node scripts/check-content-governance.mjs",
    "generate:governance-review": "node scripts/generate-content-governance-review-sheet.mjs",
    "check:editorial": "node scripts/check-editorial-structure.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:movies:data": "node scripts/check-movie-data.mjs",
    "check:movies:browser": "node scripts/check-movies-browser.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:content-quality": "node scripts/check-content-quality.mjs",
    "investigate:resources": "node scripts/investigate-content-resources.mjs",
    "check:remote": "node scripts/check-remote.mjs",
    "new:post": "node scripts/new-post.mjs",
    "publish:post": "node scripts/publish-post.mjs",
    "test:writing": "node --test scripts/publish-post.test.mjs",
    "check:drafts": "node scripts/check-draft-isolation.mjs",
    "import:movies": "node scripts/import-legacy-movies.mjs",
    "cache:movie-posters": "node scripts/cache-movie-posters.mjs",
    "sync:trakt-public": "node scripts/sync-trakt-public.mjs",
    "enrich:movie-posters": "node scripts/enrich-movie-posters.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.62.1",
    "typescript-eslint": "^8.68.0"
  },
  "private": "true",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  }
}
